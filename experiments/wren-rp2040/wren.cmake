set(WREN_ROOT ${CMAKE_CURRENT_LIST_DIR}/vendor/wren)
if(NOT EXISTS ${WREN_ROOT}/src/include/wren.h)
  message(FATAL_ERROR "Run python3 tools/acquire.py first")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/tools/verify_sources.py RESULT_VARIABLE VERIFY_RESULT)
if(NOT VERIFY_RESULT EQUAL 0)
  message(FATAL_ERROR "Pinned Wren source verification failed")
endif()
# Build only the official VM, no CLI, optional modules, IO or filesystem.
file(GLOB WREN_SOURCES CONFIGURE_DEPENDS ${WREN_ROOT}/src/vm/*.c)
add_library(wren_vm STATIC ${WREN_SOURCES})
target_include_directories(wren_vm PUBLIC ${WREN_ROOT}/src/include PRIVATE ${WREN_ROOT}/src/vm)
target_compile_definitions(wren_vm PRIVATE WREN_OPT_META=0 WREN_OPT_RANDOM=0)
if(CMAKE_CROSSCOMPILING)
  target_compile_options(wren_vm PRIVATE -Os -ffunction-sections -fdata-sections -fstack-usage)
else()
  target_compile_options(wren_vm PRIVATE -O2 -fstack-usage)
endif()
