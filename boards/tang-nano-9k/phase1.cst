// OSER10 RESET recovery is checked against the FCLK falling edge; keep each
// last reset stage in the CFU row next to its TMDS IOLOGIC site (IOT38..42).
INS_LOC "link/protocol/serializer/serial_reset_lane_2_s0" R2C38[0][A];
INS_LOC "link/protocol/serializer/serial_reset_lane_1_s0" R2C39[0][A];
INS_LOC "link/protocol/serializer/serial_reset_lane_0_s0" R2C41[0][A];
INS_LOC "link/protocol/serializer/serial_reset_lane_3_s0" R2C42[0][A];
// The two synchronizer stages sit between the lane copies so the last FCLK
// hop stays a single-cycle path at 371.25MHz too.
INS_LOC "link/protocol/serializer/serial_reset_1_s0" R2C40[0][A];
INS_LOC "link/protocol/serializer/serial_reset_0_s0" R2C40[0][B];
