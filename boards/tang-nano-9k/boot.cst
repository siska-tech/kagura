// ROM-less boot-only pins.  Pin 26 is the header BOOT_MAP output; 59-62
// connect to the on-board P25Q32U SPI NOR. Pin 51 (J5-17) is the carrier reset
// request, pin 53 (J5-18) senses the CPU RESB net (both 3.3 V Bank 1 inputs).
IO_LOC "boot_map" 26;
IO_LOC "flash_sclk" 59;
IO_LOC "flash_cs_n" 60;
IO_LOC "flash_mosi" 61;
IO_LOC "flash_miso" 62;
IO_LOC "cpu_reset_req_n" 51;
IO_LOC "cpu_resb_sense" 53;
IO_PORT "boot_map" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=DOWN;
IO_PORT "flash_sclk" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=DOWN;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "cpu_reset_req_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "cpu_resb_sense" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
