# Reuse the established test sources; no forked goldens or weaker assertions.
add_executable(text_tests ${KD_TEXT}/tests/test_text.c)
target_link_libraries(text_tests PRIVATE Kagura::Text)
add_test(NAME text_core COMMAND text_tests)
add_executable(text_oracle ${KD_TEXT}/tests/oracle.c)
target_link_libraries(text_oracle PRIVATE Kagura::Text)
add_test(NAME unicode_font_oracle COMMAND ${Python3_EXECUTABLE} -I ${KD_TEXT}/tests/oracle.py $<TARGET_FILE:text_oracle>)
add_executable(native_tests ${KD_TEXT}/tests/test_desktop.c)
target_link_libraries(native_tests PRIVATE Kagura::Native)
add_test(NAME text_desktop COMMAND native_tests)
add_executable(native_demo ${KD_TEXT}/host/demo.c)
target_link_libraries(native_demo PRIVATE Kagura::Native)
file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/native-demo)
add_test(NAME japanese_titles_demo COMMAND native_demo ${CMAKE_CURRENT_BINARY_DIR}/native-demo)
add_executable(native_application ${CMAKE_CURRENT_LIST_DIR}/native_application.c ${KD_WD}/tests/mock_hal.c)
target_include_directories(native_application PRIVATE ${KD_WD}/tests)
target_compile_options(native_application PRIVATE -Wall -Wextra -Werror)
target_link_libraries(native_application PRIVATE Kagura::Application)
add_test(NAME runtime_free_application COMMAND native_application)
