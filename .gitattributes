# Preserve exact bytes of SHA-256 identified benchmark artifacts and snapshots.
/docs/framebuffer-*-logs/** -text
/docs/framebuffer-*.md -text
/docs/framebuffer-*.json -text
/docs/images/framebuffer-transport-baseline.svg -text
/tools/plot-framebuffer-transport.py -text

# Device image payloads and tile-native captions are byte-exact, not text.
/software/micropython/examples/showcase_assets/*.kimg binary
/software/micropython/examples/showcase_assets/*.caption binary
/software/micropython/examples/showcase_assets/*.scenery binary
/software/micropython/examples/starfall_assets/*.bin binary
